{
  "name": "junior-vraiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.x",
    "pnpm": "11.25.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:schemas": "vitest run --config vitest.schemas.config.ts",
    "test:live:france-travail": "vitest run src/lib/france-travail/client.live.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:lighthouse": "lhci autorun",
    "classifier:validate:local": "tsx scripts/merge-agent-review-200.ts && tsx scripts/merge-targeted-reference.ts && tsx scripts/evaluate-classifier-reference.ts && tsx scripts/verify-classifier-validation-report.ts",
    "classifier:report:check": "tsx scripts/verify-classifier-validation-report.ts",
    "query-set:validate:local": "tsx scripts/merge-query-set-reference.ts --directory=.local/query-set-validation-v2 --query-set=docs/reference/query-set.observed-v2-draft.json && tsx scripts/evaluate-query-set-reference.ts --directory=.local/query-set-validation-v2 --query-set=docs/reference/query-set.observed-v2-draft.json --output=docs/reference/query-set-v2-validation-report.json && tsx scripts/promote-query-set.ts && tsx scripts/verify-query-set-validation-report.ts",
    "query-set:report:check": "tsx scripts/verify-query-set-validation-report.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate --config drizzle.migrate.config.ts",
    "db:check": "drizzle-kit check",
    "taxonomy:sync": "tsx scripts/sync-taxonomies.ts",
    "classifier:reclassify-current": "tsx scripts/reclassify-current-dataset.ts",
    "insights:publish:initial": "tsx scripts/publish-initial-insights.ts",
    "trigger:dev": "trigger dev start",
    "trigger:deploy": "trigger deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@sentry/nextjs": "10.73.0",
    "@tanstack/react-table": "9.2.4",
    "@trigger.dev/sdk": "4.5.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.39.0",
    "motion": "13.1.1",
    "next": "16.3.4",
    "nuqs": "2.10.1",
    "posthog-js": "1.425.1",
    "radix-ui": "1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "4.20.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@trigger.dev/build": "4.5.15",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "trigger.dev": "4.5.15",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
