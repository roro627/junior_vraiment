# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# `DATABASE_URL_UNPOOLED` émis par le CLI Neon est accepté comme alias.
DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# France Travail — server/worker only
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
FRANCE_TRAVAIL_TOKEN_URL=
FRANCE_TRAVAIL_API_BASE_URL=
INGESTION_REQUESTS_PER_SECOND=10

# Trigger.dev — worker only
TRIGGER_SECRET_KEY=

# Internal cache publication
REVALIDATION_URL=http://localhost:3000/api/internal/revalidate
REVALIDATION_SECRET=
API_CURSOR_SECRET=

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Product analytics — keep disabled until final legal/privacy review
ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# App
APP_ENV=development
LOG_LEVEL=info
DATASET_STALE_AFTER_HOURS=30
DATASET_CRITICAL_AFTER_HOURS=72
RAW_PAYLOAD_RETENTION_DAYS=90
