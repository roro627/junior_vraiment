{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "documentVersion": "1.2.0",
  "status": "initial-baseline-to-validate-against-source",
  "locale": "fr-FR",
  "notes": [
    "Les identifiants sont publics et doivent rester stables après le lancement.",
    "Les alias servent à détecter une technologie ou à composer les requêtes de collecte; ils ne remplacent pas les référentiels de France Travail.",
    "Une occurrence dans le nom d'une entreprise, une URL, une liste de bénéfices ou un bloc légal ne doit pas être comptée comme compétence.",
    "Toute modification influençant les résultats exige une nouvelle version de taxonomie et un recalcul comparable."
  ],
  "technologyMatchingContract": {
    "defaultCaseSensitivity": "insensitive",
    "defaultBoundary": "unicode_word",
    "matchFields": [
      "title",
      "description",
      "skills",
      "experienceLabel"
    ],
    "ignoredSections": [
      "company_name",
      "application_url",
      "legal_footer",
      "benefits_boilerplate"
    ],
    "shortAliasMaximumLength": 3,
    "shortAliasPolicy": "Un alias de trois caractères ou moins exige la casse exacte ou un signal technique dans une fenêtre de 80 caractères.",
    "contextWindowCharacters": 80,
    "evidenceRequired": true,
    "multipleMatchesPerTechnology": "deduplicate_per_offer_snapshot",
    "overlapPolicy": "Le motif le plus long gagne avant les exclusions; par exemple React Native est évalué avant React."
  },
